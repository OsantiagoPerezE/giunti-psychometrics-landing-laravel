md() {
  @media (min-width: $bp-md) {
    {block};
  }
}

lg() {
  @media (min-width: $bp-lg) {
    {block};
  }
}

hover() {
  @media (hover: hover) {
    &:hover {
      {block};
    }
  }
}

focus-ring(offset = 2px, color = $accent) {
  &:focus-visible {
    outline: 2px solid color;
    outline-offset: offset;
  }
}

reduced-motion() {
  @media (prefers-reduced-motion: reduce) {
    {block};
  }
}

container(max = $container) {
  width: 100%;
  max-width: max;
  margin-left: auto;
  margin-right: auto;
  padding-left: 16px;
  padding-right: 16px;

  +md() {
    padding-left: 24px;
    padding-right: 24px;
  }

  +lg() {
    padding-left: 32px;
    padding-right: 32px;
  }
}

cover-image() {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

text(size) {
  font-size: size;

  if (size == 12px) {
    line-height: (16 / 12);
  } else if (size == 14px) {
    line-height: (20 / 14);
  } else if (size == 16px) {
    line-height: 1.5;
  } else if (size == 18px) {
    line-height: (28 / 18);
  } else if (size == 20px) {
    line-height: 1.4;
  } else if (size == 24px) {
    line-height: (32 / 24);
  } else if (size == 30px) {
    line-height: 1.2;
  } else if (size == 36px) {
    line-height: (40 / 36);
  } else if (size >= 48px) {
    line-height: 1;
  }
}
