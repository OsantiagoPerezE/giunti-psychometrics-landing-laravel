.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 24px;
  border: 0 solid transparent;
  border-radius: $radius-sm;
  text(16px);
  font-weight: 600;
  text-align: center;
  transition: transform 200ms, background-color 200ms, color 200ms, box-shadow 200ms, border-color 200ms;
  focus-ring();

  &:active {
    transform: translateY(0);
  }

  &:disabled {
    opacity: 0.7;
    pointer-events: none;
  }

  &__arrow {
    transition: transform 200ms;
  }

  +hover() {
    .button__arrow {
      transform: translateX(4px);
    }
  }

  &--primary {
    background: $primary;
    color: $white;

    +hover() {
      background: $ink;
      box-shadow: $shadow-md;
      transform: translateY(-2px);
    }
  }

  &--accent {
    background: $accent;
    color: $ink;

    +hover() {
      background: $white;
      box-shadow: $shadow-lg;
      transform: translateY(-2px);
    }
  }

  &--soft {
    background: $surface;
    color: $primary;
    font-weight: 700;

    +hover() {
      background: $primary;
      color: $white;
      box-shadow: $shadow-md;
      transform: translateY(-2px);
    }
  }

  &--outline {
    border-width: 2px;
    border-color: $primary;
    color: $primary;
    font-weight: 700;

    +hover() {
      background: $primary;
      color: $white;
      box-shadow: $shadow-md;
      transform: translateY(-2px);
    }
  }

  &--outline-light {
    border-width: 2px;
    border-color: $white;
    color: $white;

    +hover() {
      background: $white;
      color: $ink;
      box-shadow: $shadow-lg;
      transform: translateY(-2px);
    }
  }

  &--pill {
    border-radius: 999px;
    padding: 8px 20px;
    text(14px);
  }

  &--large {
    padding: 16px 36px;
    text(18px);
  }

  &--block {
    width: 100%;
  }

  &.is-done {
    background: $success;
  }
}

.icon-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 999px;
  color: $ink;
  transition: background-color 200ms, color 200ms, transform 200ms;
  focus-ring();

  &:active {
    transform: scale(0.9);
  }

  +hover() {
    background: $surface;
    color: $primary;
  }

  +md() {
    width: 48px;
    height: 48px;
  }

  &__icon {
    width: 22px;
    height: 22px;
  }
}
