.footer
  background $ink
  color $white

  &__newsletter
    border-bottom 1px solid rgba($white, .15)

  &__newsletter-inner
    container()
    display grid
    align-items center
    gap 24px
    padding-top 40px
    padding-bottom 40px
    +lg()
      grid-template-columns 1fr 1fr
      gap 48px

  &__newsletter-form
    +lg()
      justify-self end
      width 100%
      max-width 448px

  &__heading
    text(24px)
    font-weight 700

  &__muted
    margin-top 8px
    max-width 448px
    color $sky-100

  &__main
    container()
    display grid
    gap 40px
    padding-top 48px
    padding-bottom 48px
    +md()
      grid-template-columns 1fr 1fr
    +lg()
      grid-template-columns 1.4fr 1fr 1fr 1fr

  &__brand
    +md()
      grid-column span 2
    +lg()
      grid-column span 1

  &__tagline
    margin-top 16px
    max-width 320px
    text(14px)

  &__address
    margin-top 20px
    text(14px)
    font-style normal
    color $sky-100
    p + p
      margin-top 8px

  &__column-title
    text(18px)
    font-weight 700

  &__column-list
    margin-top 16px
    text(14px)
    color $sky-100
    li + li
      margin-top 12px

  &__link
    display inline-block
    border-radius 4px
    transition color 150ms, transform 200ms
    focus-ring()
    +hover()
      color $white
      text-decoration underline

    &--nav
      +hover()
        transform translateX(4px)

  &__bottom
    border-top 1px solid rgba($white, .15)

  &__bottom-inner
    container()
    display flex
    flex-direction column
    gap 20px
    padding-top 24px
    padding-bottom 24px
    +lg()
      flex-direction row
      align-items center
      justify-content space-between

  &__legal
    text(12px)
    color $sky-100

  &__legal-list
    display flex
    flex-wrap wrap
    gap 4px 20px
    margin-top 8px

  &__end
    display flex
    align-items center
    gap 16px

  &__social
    display flex
    gap 12px

  &__social-link
    display flex
    align-items center
    justify-content center
    width 40px
    height 40px
    border 1px solid rgba($white, .4)
    border-radius 999px
    transition transform 200ms, background-color 200ms, color 200ms
    focus-ring()
    +hover()
      transform translateY(-4px)
      background $white
      color $ink

  &__top
    display inline-flex
    align-items center
    gap 8px
    padding 8px 16px
    border 1px solid rgba($white, .4)
    border-radius 999px
    text(14px)
    font-weight 600
    transition background-color 150ms, color 150ms
    focus-ring()
    +hover()
      background $white
      color $ink

.newsletter
  display flex
  flex-direction column
  gap 12px

  &__input
    width 100%
    padding 12px 16px
    border 1px solid rgba($white, .5)
    border-radius $radius-sm
    background transparent
    color $white
    focus-ring()
    &::placeholder
      color rgba($sky-100, .8)

  &__error
    text(14px)
    color #FFCACA

  &__submit
    padding 12px 16px

  &__done
    font-weight 600
