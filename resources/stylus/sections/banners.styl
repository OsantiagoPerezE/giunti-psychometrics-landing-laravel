.promo-banners {
  &__grid {
    display: grid;
    gap: 24px;

    +md() {
      grid-template-columns: 1fr 1fr;
    }
  }
}

.promo-banner {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 16rem;
  padding: 28px;
  overflow: hidden;
  border: 1px solid rgba($primary, 0.1);
  border-radius: $radius-lg;
  box-shadow: $shadow-sm;
  transition: transform 300ms, box-shadow 300ms;

  +hover() {
    transform: translateY(-4px);
    box-shadow: $shadow-xl;

    .promo-banner__image {
      transform: scale(1.05);
    }
  }

  &--large {
    +md() {
      grid-column: span 2;
      min-height: 20rem;
      padding: 40px;
    }
  }

  &__image {
    cover-image();
    transition: transform 700ms;
  }

  &__overlay {
    position: absolute;
    inset: 0;
    background: rgba($white, 0.85);

    +md() {
      background-image: linear-gradient(to right, $white 35%, rgba($white, 0.9), rgba($white, 0.6));
    }
  }

  &__content, &__cta {
    position: relative;
  }

  &__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba($primary, 0.1);
    color: $primary;
    text(12px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  &__title {
    margin-top: 16px;
    max-width: 448px;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.375;
    color: $ink;
  }

  &--large &__title {
    max-width: 576px;

    +md() {
      font-size: 30px;
    }
  }

  &__points {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin-top: 16px;
    text(14px);
    font-weight: 500;
    color: rgba($ink, 0.8);
  }

  &__point {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  &__check {
    color: $primary;
  }

  &__cta {
    align-self: flex-start;
    margin-top: 24px;
    padding: 10px 24px;
    text(14px);
  }
}

.photo-banner {
  &__box {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 26rem;
    overflow: hidden;
    border-radius: $radius-xl;
    text-align: center;
  }

  &__image {
    cover-image();
  }

  &__overlay {
    position: absolute;
    inset: 0;
    background: rgba($ink, 0.7);
  }

  &__content {
    position: relative;
    padding: 48px 24px;
    color: $white;
  }

  &__title {
    max-width: 768px;
    margin: 0 auto;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.25;

    +md() {
      font-size: 36px;
    }
  }

  &__cta {
    margin-top: 32px;
    padding: 14px 32px;
    focus-ring(4px, $white);
  }
}

.mission {
  &__box {
    padding: 64px 24px;
    border-radius: $radius-xl;
    background: $ink;
    color: $white;
    text-align: center;

    +md() {
      padding-left: 48px;
      padding-right: 48px;
    }
  }

  &__title {
    text(30px);
    font-weight: 700;

    +md() {
      text(36px);
    }
  }

  &__text {
    max-width: 768px;
    margin: 24px auto 0;
    text(18px);
    color: $sky-100;
  }

  &__cta {
    margin-top: 32px;
    padding: 12px 32px;
    focus-ring(4px);
  }
}

.news {
  padding-top: 48px;
  padding-bottom: 0;

  &__grid {
    display: grid;
    gap: 24px;
    margin-top: 32px;

    +md() {
      grid-template-columns: 1fr 1fr;
    }
  }
}

.news-card {
  height: 100%;
  overflow: hidden;
  border: 1px solid rgba($primary, 0.1);
  border-radius: $radius-lg;
  background: $white;
  box-shadow: $shadow-sm;
  transition: transform 300ms, box-shadow 300ms, border-color 300ms;

  +hover() {
    transform: translateY(-4px);
    border-color: rgba($primary, 0.3);
    box-shadow: $shadow-xl;

    .news-card__image {
      transform: scale(1.05);
    }
  }

  &__media {
    position: relative;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    background: $surface;
  }

  &__image {
    cover-image();
    transition: transform 500ms;
  }

  &__body {
    padding: 24px;
  }

  &__title {
    text(20px);
    font-weight: 600;
  }

  &__excerpt {
    margin-top: 8px;
    color: rgba($ink, 0.8);
  }
}

.trust-bar {
  background: $ink;
  color: $white;

  &__list {
    container();
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    padding-top: 40px;
    padding-bottom: 40px;

    +md() {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  &__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    transition: transform 200ms;

    +hover() {
      transform: translateY(-4px);
    }
  }

  &__icon {
    width: 32px;
    height: 32px;
  }

  &__label {
    font-weight: 600;
  }
}
