.hero {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  min-height: 34rem;
  overflow: hidden;
  background: $ink;
  color: $white;

  +lg() {
    min-height: 38rem;
  }

  &__image {
    cover-image();
    z-index: -2;
    object-position: 70% 35%;
  }

  &__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgba($ink, 0.85), rgba($ink, 0.8), rgba($ink, 0.75));

    +lg() {
      background: linear-gradient(to right, rgba($ink, 0.9), rgba($ink, 0.8), rgba($ink, 0.15));
    }
  }

  &__inner {
    container();
    position: relative;
    display: grid;
    align-items: center;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 56px;

    +lg() {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      padding-top: 96px;
      padding-bottom: 96px;
    }
  }

  &__content {
    max-width: 672px;
    animation: hero-in 600ms $ease-out both;
  }

  &__badge {
    display: inline-block;
    margin-bottom: 16px;
    padding: 6px 16px;
    border-radius: 999px;
    background: $accent;
    color: $ink;
    text(14px);
    font-weight: 600;
    box-shadow: $shadow-sm;
  }

  &__title {
    font-size: 36px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.025em;

    +md() {
      font-size: 48px;
    }
  }

  &__description {
    margin-top: 24px;
    max-width: 576px;
    text(18px);
    color: rgba($white, 0.95);
  }

  &__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
  }

  &__cta {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
    focus-ring(4px, $white);
  }

  &__promo {
    display: inline-flex;
    flex-direction: column;
    justify-self: start;
    padding: 16px 24px;
    border: 2px solid rgba($white, 0.8);
    border-radius: $radius-lg;
    background: $white;
    color: $ink;
    box-shadow: $shadow-xl;
    animation: hero-in 600ms 120ms $ease-out both;

    +lg() {
      justify-self: end;
      align-self: end;
    }
  }

  &__promo-percent {
    text(30px);
    font-weight: 700;
    color: $primary;
  }

  &__promo-name {
    margin-top: 2px;
    max-width: 15rem;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.375;
  }

  &__product {
    padding: 14px 28px;
    font-weight: 600;
    focus-ring(4px);
  }
}
